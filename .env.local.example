# Copiá este archivo a ".env.local" (mismo directorio) y completá los
# valores. Sacás los dos de acá: supabase.com > tu proyecto > Project
# Settings > API.
#
# Sin estas dos variables, la app funciona igual (resultados, fixture,
# posiciones, fichas de equipo con datos de ejemplo), pero el login y el
# chat del hincha se muestran "todavía no conectado".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: la URL pública donde va a vivir la app (se usa para las
# etiquetas de metadata al compartir en redes). En local no hace falta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notificaciones push (botón "Avisarme" en cada partido) ---
# Sin esto la app funciona igual, pero el botón de avisos queda
# deshabilitado. Ver README > "Notificaciones push" para los pasos.

# 1) Project Settings > API > Project API keys > "service_role" (secreta,
#    nunca la mandes al navegador). Hace falta para que el cron pueda leer
#    los avisos de todos los usuarios, no solo el tuyo.
SUPABASE_SERVICE_ROLE_KEY=

# 2) Corré `npx web-push generate-vapid-keys` y pegá el par acá.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mail de contacto que exige el estándar Web Push (no hace falta que sea real).
VAPID_SUBJECT=mailto:soporte@fut90.app

# 3) Opcional pero recomendado: un secreto random para que solo tu cron
#    pueda llamar a /api/cron/send-match-reminders (si no lo poné, la ruta
#    queda abierta a cualquiera que la llame).
CRON_SECRET=
